<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Workflow Status - Sheet to Trello' }) %>
</head>
<body class="bg-gray-50">
    <%- include('partials/header', { currentPage: 'workflow', user: user }) %>

    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div class="px-4 py-6 sm:px-0">
            <div class="mb-8">
                <h1 class="text-3xl font-bold text-gray-900">Workflow Status</h1>
                <p class="mt-2 text-sm text-gray-600">View the execution results</p>
            </div>

            <% if (typeof success !== 'undefined' && success) { %>
            <div class="rounded-xl bg-green-50 border border-green-200 p-4 mb-6">
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center">
                            <i class="fas fa-check-circle text-green-600"></i>
                        </div>
                    </div>
                    <div class="ml-4 flex-1">
                        <h3 class="text-sm font-semibold text-green-900">
                            Workflow executed successfully!
                        </h3>
                        <p class="mt-1 text-sm text-green-700">
                            All cards have been created in Trello. Check the details below.
                        </p>
                    </div>
                </div>
            </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="rounded-xl bg-red-50 border border-red-200 p-4 mb-6">
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center">
                            <i class="fas fa-exclamation-circle text-red-600"></i>
                        </div>
                    </div>
                    <div class="ml-4 flex-1">
                        <h3 class="text-sm font-semibold text-red-900">
                            Error occurred
                        </h3>
                        <p class="mt-1 text-sm text-red-700">
                            <%= error %>
                        </p>
                    </div>
                </div>
            </div>
            <% } %>

            <div class="bg-white shadow-sm border border-gray-100 rounded-2xl p-8 mb-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-6 flex items-center">
                    <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center mr-3">
                        <i class="fas fa-cog text-blue-600"></i>
                    </div>
                    Workflow Details
                </h2>
                <dl class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2">
                    <div class="bg-gray-50 rounded-xl p-4">
                        <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Sheet</dt>
                        <dd class="text-sm font-medium text-gray-900"><%= workflow.sheetName || workflow.sheetId || 'Uploaded File' %></dd>
                    </div>
                    <div class="bg-gray-50 rounded-xl p-4">
                        <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Created</dt>
                        <dd class="text-sm font-medium text-gray-900">
                            <%
                                const createdDate = workflow.createdAt instanceof Date
                                    ? workflow.createdAt
                                    : new Date(workflow.createdAt);
                                const istDate = createdDate.toLocaleString('en-IN', {
                                    timeZone: 'Asia/Kolkata',
                                    year: 'numeric',
                                    month: '2-digit',
                                    day: '2-digit',
                                    hour: '2-digit',
                                    minute: '2-digit',
                                    second: '2-digit',
                                    hour12: true
                                });
                            %><%= istDate %>
                        </dd>
                    </div>
                </dl>
            </div>

            <% if (logs && logs.length > 0) { %>
            <div class="bg-white shadow-sm border border-gray-100 rounded-2xl p-8 mb-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-2 flex items-center">
                    <div class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center mr-3">
                        <i class="fas fa-list-check text-green-600"></i>
                    </div>
                    Card Creation Logs
                </h2>
                <p class="text-sm text-gray-600 mb-6 ml-[52px]">Total: <%= logs.length %> cards created</p>
                <div class="space-y-3 max-h-96 overflow-y-auto pr-2">
                    <% logs.forEach(function(log, index) { %>
                    <div class="border border-gray-200 rounded-xl p-4 hover:bg-gray-50 hover:border-gray-300 transition-all duration-150">
                        <div class="flex items-start justify-between">
                            <div class="flex-1">
                                <h3 class="text-sm font-semibold text-gray-900 flex items-center">
                                    <span class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-700 rounded-lg flex items-center justify-center text-xs font-bold mr-3">
                                        <%= index + 1 %>
                                    </span>
                                    <%= log.title %>
                                </h3>
                                <% if (log.description) { %>
                                <p class="mt-2 ml-9 text-xs text-gray-500 line-clamp-2">
                                    <%= log.description.substring(0, 100) %><% if (log.description.length > 100) { %>...<% } %>
                                </p>
                                <% } %>
                                <% if (log.cardId) { %>
                                <div class="mt-2 ml-9">
                                    <p class="text-xs text-gray-500">
                                        <span class="font-medium">Card ID:</span> <span class="font-mono"><%= log.cardId %></span>
                                    </p>
                                </div>
                                <% } %>
                                <% if (log.errorMessage) { %>
                                <div class="mt-2 ml-9">
                                    <p class="text-xs text-red-600 bg-red-50 px-2 py-1 rounded">
                                        <i class="fas fa-exclamation-circle mr-1"></i><%= log.errorMessage %>
                                    </p>
                                </div>
                                <% } %>
                                <div class="mt-3 ml-9 flex flex-wrap gap-2">
                                    <% if (log.members) { %>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-blue-100 text-blue-800 text-xs font-medium">
                                        <i class="fas fa-users mr-1.5 text-xs"></i>
                                        <%= log.members %>
                                    </span>
                                    <% } %>
                                    <% if (log.labels) { %>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-purple-100 text-purple-800 text-xs font-medium">
                                        <i class="fas fa-tags mr-1.5 text-xs"></i>
                                        <%= log.labels %>
                                    </span>
                                    <% } %>
                                    <% if (log.totalHours) { %>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-green-100 text-green-800 text-xs font-medium">
                                        <i class="fas fa-clock mr-1.5 text-xs"></i>
                                        <%= log.totalHours %> hours
                                    </span>
                                    <% } %>
                                    <% if (log.status === 'success') { %>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-green-100 text-green-800 text-xs font-medium">
                                        <i class="fas fa-check-circle mr-1.5 text-xs"></i>
                                        Success
                                    </span>
                                    <% } else if (log.status === 'failed') { %>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-red-100 text-red-800 text-xs font-medium">
                                        <i class="fas fa-times-circle mr-1.5 text-xs"></i>
                                        Failed
                                    </span>
                                    <% } else { %>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-yellow-100 text-yellow-800 text-xs font-medium">
                                        <i class="fas fa-clock mr-1.5 text-xs"></i>
                                        Pending
                                    </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% } else { %>
            <div class="bg-white shadow-sm border border-gray-100 rounded-2xl p-12 text-center">
                <div class="w-16 h-16 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-inbox text-2xl text-gray-400"></i>
                </div>
                <p class="text-gray-600 font-medium">No logs available yet</p>
                <p class="text-sm text-gray-500 mt-1">Run the workflow to see results</p>
            </div>
            <% } %>

            <div class="mt-6">
                <a href="/dashboard" class="text-sm font-medium text-blue-600 hover:text-blue-500">
                    ← Back to Dashboard 
                </a>
            </div>
        </div>
    </main>
    <%- include('partials/modal') %>
</body>
</html>
