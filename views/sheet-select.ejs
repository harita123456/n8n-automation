<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Select Google Sheet - Sheet to Trello' }) %>
</head>
<body class="bg-gray-50">
    <%- include('partials/header', { currentPage: 'workflow', user: user }) %>

    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div class="px-4 py-6 sm:px-0">
            <div class="mb-8">
                <h1 class="text-3xl font-bold text-gray-900">Select Google Sheet</h1>
                <p class="mt-2 text-sm text-gray-600">Choose a sheet from your Google Drive</p>
            </div>

            <% if (error) { %>
            <div class="rounded-md bg-red-50 p-4 mb-6">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <i class="fas fa-exclamation-circle text-red-400"></i>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-red-800">
                            <%= error %>
                        </h3>
                    </div>
                </div>
            </div>
            <% } %>

            <% if (sheets && sheets.length > 0) { %>
            <div class="bg-white shadow overflow-hidden sm:rounded-md">
                <ul class="divide-y divide-gray-200">
                    <% sheets.forEach(function(sheet) { %>
                    <li>
                        <a href="/trello/select?sheetId=<%= sheet.id %>&sheetName=<%= encodeURIComponent(sheet.name) %>" class="block hover:bg-gray-50">
                            <div class="px-4 py-4 sm:px-6">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center">
                                        <i class="fas fa-file-excel text-green-500 text-2xl mr-3"></i>
                                        <p class="text-sm font-medium text-gray-900">
                                            <%= sheet.name %>
                                        </p>
                                    </div>
                                    <div class="ml-2 flex-shrink-0">
                                        <i class="fas fa-chevron-right text-gray-400"></i>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <p class="text-sm text-gray-500">
                                        Modified: <%= new Date(sheet.modifiedTime).toLocaleDateString() %>
                                    </p>
                                </div>
                            </div>
                        </a>
                    </li>
                    <% }); %>
                </ul>
            </div>
            <% } else { %>
            <div class="bg-white shadow rounded-lg p-6 text-center">
                <i class="fas fa-folder-open text-4xl text-gray-400 mb-4"></i>
                <p class="text-gray-500">No Google Sheets found in your Drive</p>
            </div>
            <% } %>

            <div class="mt-6">
                <a href="/dashboard" class="text-sm font-medium text-blue-600 hover:text-blue-500">
                    ← Back to Dashboard
                </a>
            </div>
        </div>
    </main>
    <%- include('partials/modal') %>
</body>
</html>
